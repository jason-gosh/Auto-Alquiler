{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoAlquiler",
  "version": "1.0.0",
  "identifier": "com.autoalquiler.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AutoAlquiler - Gestión de Alquiler de Vehículos",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#151522",
        "url": "http://localhost:8070"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
